<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo">

    <!-- Guías en porcentaje: la UI se reparte bien en cualquier tamaño/orientación -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.18" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaBoton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.40" />

    <TextView
        android:id="@+id/textoBienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bienvenido"
        android:textColor="@color/blanco"
        android:textSize="@dimen/titulo_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guiaTitulo" />

    <Button
        android:id="@+id/botonEntrar"
        android:layout_width="@dimen/boton_ancho"
        android:layout_height="@dimen/boton_alto"
        android:background="@drawable/boton_borde"
        android:text="@string/entrar"
        android:textAllCaps="false"
        android:textColor="@color/blanco"
        android:textSize="@dimen/boton_texto_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guiaBoton" />

</androidx.constraintlayout.widget.ConstraintLayout>
